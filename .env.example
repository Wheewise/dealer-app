# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host:5432/wheewise?sslmode=require"

# NextAuth
# AUTH_SECRET must be IDENTICAL across the user / dealer / admin deployments —
# each one verifies JWTs the others issued.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Cross-subdomain sessions. Set to the parent domain (leading dot) so one
# sign-in carries across all three apps. Leave EMPTY for local development and
# for single-host deployments — an unset value keeps stock cookie behaviour.
#   AUTH_COOKIE_DOMAIN=".wheewise.com"
AUTH_COOKIE_DOMAIN=""

# Origins of the three role apps. Used to redirect a caller into the app that
# matches their role (post-login, and when they land on the wrong subdomain).
# Leave EMPTY when everything runs on one host — all redirects stay relative,
# which is the pre-split behaviour.
#   NEXT_PUBLIC_USER_APP_URL="https://wheewise.com"
#   NEXT_PUBLIC_DEALER_APP_URL="https://dealer.wheewise.com"
#   NEXT_PUBLIC_ADMIN_APP_URL="https://admin.wheewise.com"
NEXT_PUBLIC_USER_APP_URL=""
NEXT_PUBLIC_DEALER_APP_URL=""
NEXT_PUBLIC_ADMIN_APP_URL=""

# Restrict user-supplied image URLs to hosts you control (comma-separated).
# Empty = any public https host.
UPLOAD_HOST_ALLOWLIST=""

# Vercel Blob storage for vehicle photos
BLOB_READ_WRITE_TOKEN=""

# Razorpay subscriptions
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Razorpay plan IDs (create in dashboard, paste here)
RAZORPAY_PLAN_MONTHLY=""
RAZORPAY_PLAN_YEARLY=""

# Resend (email)
RESEND_API_KEY=""
RESEND_FROM="Wheewise <noreply@wheewise.com>"

# Sentry (optional — error monitoring)
# SENTRY_DSN="https://<key>@<host>/<project>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@<host>/<project>"

# SMS provider — set MSG91 (preferred for India) OR Twilio.
# Without either, sendSms() falls back to console in dev and THROWS in prod.
# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID="WHWISE"
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# KYC providers (GST + RTO lookups). When unset, /api/gst/verify returns 503
# and /api/rto returns 503. Mock data only emits with the WHEEWISE_MOCK_* flags
# below, AND only in NODE_ENV=development.
# SUREPASS_TOKEN=""
# SUREPASS_BASE_URL="https://kyc-api.surepass.io/api/v1"
# Optionally override RTO endpoint independently:
# RTO_PROVIDER_TOKEN=""
# RTO_PROVIDER_URL="https://kyc-api.surepass.io/api/v1"

# AI description generation (optional — falls back to template if not set)
# Set one or both; OpenAI is tried first, then Anthropic, then mock templates.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only flags. ALL of these refuse to boot when NODE_ENV=production
# (the server throws at startup). Each ALSO requires NODE_ENV=development
# at request time before any behavior changes.
#
# OTP_DEV_BYPASS=1            — force OTP "000000" in local dev.
# WHEEWISE_DEV_LOGIN=1        — enable the "dev: instant sign-in as dealer" login.
# WHEEWISE_MOCK_GST=1         — return fake GST verification data for any valid-format GSTIN.
# WHEEWISE_MOCK_RTO=1         — return fake RTO vehicle lookup data.
