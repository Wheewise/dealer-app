# ---------------------------------------------------------------------------
# Supabase — the database, and the whole data layer.
#
# Project Settings → API in the Supabase dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It is the highest
# value secret in the system: server-side only, never NEXT_PUBLIC_, never in a
# client component, never in a browser-reachable bundle.
#
# Apply supabase/schema.sql once in the SQL editor before first boot.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: overrides NEXT_PUBLIC_SUPABASE_URL for server-side clients, so the
# project URL need not appear in the browser bundle at all.
# SUPABASE_URL="https://<project-ref>.supabase.co"

# Only for the CLI helpers (db:push, db:types, rls:verify) — not read by the app.
# SUPABASE_PROJECT_REF=""
# SUPABASE_DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# NextAuth
# AUTH_SECRET must be IDENTICAL across the user / dealer / admin deployments —
# each one verifies JWTs the others issued.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Cross-subdomain sessions. Set to the parent domain (leading dot) so one
# sign-in carries across all three apps. Leave EMPTY for local development and
# for single-host deployments — an unset value keeps stock cookie behaviour.
#   AUTH_COOKIE_DOMAIN=".wheewise.com"
AUTH_COOKIE_DOMAIN=""

# Origins of the three role apps. Used to redirect a caller into the app that
# matches their role (post-login, and when they land on the wrong subdomain).
# Leave EMPTY when everything runs on one host — all redirects stay relative,
# which is the pre-split behaviour.
#   NEXT_PUBLIC_USER_APP_URL="https://wheewise.com"
#   NEXT_PUBLIC_DEALER_APP_URL="https://dealer.wheewise.com"
#   NEXT_PUBLIC_ADMIN_APP_URL="https://admin.wheewise.com"
NEXT_PUBLIC_USER_APP_URL=""
NEXT_PUBLIC_DEALER_APP_URL=""
NEXT_PUBLIC_ADMIN_APP_URL=""

# Restrict user-supplied image URLs to hosts you control (comma-separated).
# Empty = any public https host.
UPLOAD_HOST_ALLOWLIST=""

# ---------------------------------------------------------------------------
# Upstash Redis — shared store for rate limiting and phone OTPs.
#
# REQUIRED IN PRODUCTION. Without it both fall back to per-process memory:
#   - rate limits reset on every cold start (login throttling stops working)
#   - OTPs issued by one instance are invisible to the next, so phone login
#     fails outright.
# Create a database at console.upstash.com and copy the REST credentials.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Cloudflare R2 — listing photo storage, served from Cloudflare's CDN edge.
#
# Create a bucket, give it a public hostname (custom domain preferred over the
# pub-*.r2.dev URL), then mint an R2 API token with Object Read & Write.
# The bucket MUST be publicly readable, or uploads will succeed and every
# read will 404 — R2 ignores per-object ACLs.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""          # e.g. https://cdn.wheewise.com

# Deprecated: only used if the R2 variables above are unset, so uploads keep
# working during the migration. Remove once every environment has R2.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection on the unauthenticated / costly forms:
# public enquiry, OTP send (each one is a paid SMS), login and signup.
#
# Unset = verification is SKIPPED, so local development needs no Cloudflare
# account. Production must set both, or the protection silently does nothing.
# Create a widget at dash.cloudflare.com → Turnstile.
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Razorpay subscriptions
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Razorpay plan IDs (create in dashboard, paste here)
RAZORPAY_PLAN_MONTHLY=""
RAZORPAY_PLAN_YEARLY=""

# Resend (email)
RESEND_API_KEY=""
RESEND_FROM="Wheewise <noreply@wheewise.com>"

# Sentry (optional — error monitoring)
# SENTRY_DSN="https://<key>@<host>/<project>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@<host>/<project>"

# SMS provider — set MSG91 (preferred for India) OR Twilio.
# Without either, sendSms() falls back to console in dev and THROWS in prod.
# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID="WHWISE"
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# KYC providers (GST + RTO lookups). When unset, /api/gst/verify returns 503
# and /api/rto returns 503. Mock data only emits with the WHEEWISE_MOCK_* flags
# below, AND only in NODE_ENV=development.
# SUREPASS_TOKEN=""
# SUREPASS_BASE_URL="https://kyc-api.surepass.io/api/v1"
# Optionally override RTO endpoint independently:
# RTO_PROVIDER_TOKEN=""
# RTO_PROVIDER_URL="https://kyc-api.surepass.io/api/v1"

# AI description generation (optional — falls back to template if not set)
# Set one or both; OpenAI is tried first, then Anthropic, then mock templates.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only flags. ALL of these refuse to boot when NODE_ENV=production
# (the server throws at startup). Each ALSO requires NODE_ENV=development
# at request time before any behavior changes.
#
# OTP_DEV_BYPASS=1            — force OTP "000000" in local dev.
# WHEEWISE_DEV_LOGIN=1        — enable the "dev: instant sign-in as dealer" login.
# WHEEWISE_MOCK_GST=1         — return fake GST verification data for any valid-format GSTIN.
# WHEEWISE_MOCK_RTO=1         — return fake RTO vehicle lookup data.
